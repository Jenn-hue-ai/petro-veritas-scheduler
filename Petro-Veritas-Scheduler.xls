<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
<Worksheet ss:Name="Start here"><Table>
<Row><Cell><Data ss:Type="String">Petro Veritas Field Scheduler</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">Open in Excel. Do not unzip this file.</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">Fill Workers, Clients, Jobs, then Assignments.</Data></Cell></Row>
<Row><Cell><Data ss:Type="String">Use Pair ID for a lead + helper. Leave blank for solo.</Data></Cell></Row>
</Table></Worksheet>
